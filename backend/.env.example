APP_NAME="SMART Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=<your smtp host>
MAIL_PORT=587
MAIL_USERNAME=<user>
MAIL_PASSWORD=<password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@<your domain>"

# --- Frontend / CORS ---
# React (Vite) dev server origin, used by config/cors.php
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173


# --- Admin seeding / auth hardening ---
# Used by AdminUserSeeder. REQUIRED when APP_ENV=production.
ADMIN_SEED_HREP_ID=HREP-2024-0001
ADMIN_SEED_PASSWORD=12345
# Admin token lifetime in minutes (480 = 8 hours)
SANCTUM_EXPIRATION=480

# For deployment, switch these:
# APP_ENV=production
# APP_DEBUG=false