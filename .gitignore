# ---- Environment / secrets ----
.env
.env.*
!.env.example
backend/.env
frontend/.env
pdf-service/.env

# ---- Backend (Laravel) ----
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/app/*
!backend/storage/app/.gitkeep
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
!backend/storage/framework/**/.gitkeep
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitkeep
backend/public/storage
backend/.phpunit.result.cache

# ---- Frontend (React/Vite) ----
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# ---- PDF Render Service ----
pdf-service/node_modules/
pdf-service/.chrome-cache/
# daemon/ is fully generated by install.ps1 (bakes in an absolute machine path) — never commit it
pdf-service/daemon/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Misc logs ----
*.log
npm-debug.log*

backend/public/%SystemDrive%/