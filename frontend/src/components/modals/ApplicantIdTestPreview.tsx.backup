import { useEffect, useRef, useState } from "react";
import { createPortal } from "react-dom";
import { api } from "../../api/client";

// Distinct from ApplicantIdPreviewModal: this is the "pre-approval" quick
// look reviewers use before deciding, so it's styled with an orange accent
// (matching the "Preview ID" trigger button) and labeled as a draft/test
// preview rather than the final approved ID artifact.
type PreviewType = "access-pass" | "vehicle-sticker";

const COPY: Record<PreviewType, { title: string; description: string }> = {
  "access-pass": {
    title: "Access Pass ID — Test Preview",
    description: "Draft render for review. Not yet approved.",
  },
  "vehicle-sticker": {
    title: "Vehicle Sticker ID — Test Preview",
    description: "Draft render for review. Not yet approved.",
  },
};

export function ApplicantIdTestPreview({
  type,
  previewUrl,
  downloadUrl,
  fileName = "ID.pdf",
  onClose,
  onDownloaded,
}: {
  type: PreviewType;
  previewUrl: string;
  downloadUrl: string;
  fileName?: string;
  onClose: () => void;
  onDownloaded: () => void;
}) {
  const [downloading, setDownloading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [previewHtml, setPreviewHtml] = useState<string | null>(null);
  const [loadingPreview, setLoadingPreview] = useState(true);
  // Same fast-double-click guard as ApplicantIdPreviewModal — prevents a
  // second Browsershot/Puppeteer spawn from a repeat click before
  // `downloading` state re-renders the disabled button.
  const downloadInFlight = useRef(false);
  const copy = COPY[type];

  useEffect(() => {
    let cancelled = false;

    async function loadPreview() {
      setLoadingPreview(true);
      setError(null);
      try {
        const res = await api.get<string>(previewUrl, {
          headers: { Accept: "text/html" },
          responseType: "text",
        });

        if (!cancelled) {
          setPreviewHtml(res.data);
        }
      } catch (err) {
        if (!cancelled) {
          setError("Could not load the preview.");
        }
      } finally {
        if (!cancelled) {
          setLoadingPreview(false);
        }
      }
    }

    loadPreview();

    return () => {
      cancelled = true;
    };
  }, [previewUrl]);

  async function handleDownload() {
    if (downloadInFlight.current) return;
    downloadInFlight.current = true;

    setError(null);
    setDownloading(true);
    try {
      const res = await api.get(downloadUrl, {
        headers: { Accept: "application/pdf" },
        responseType: "blob",
      });

      const objectUrl = window.URL.createObjectURL(res.data);

      const link = document.createElement("a");
      link.href = objectUrl;
      link.download = fileName;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.URL.revokeObjectURL(objectUrl);

      onDownloaded();
    } catch (err) {
      setError("Could not download the ID.");
    } finally {
      setDownloading(false);
      downloadInFlight.current = false;
    }
  }

  return createPortal(
    <div className="fixed inset-0 z-[10000] flex items-center justify-center bg-black/50 backdrop-blur-[2px] p-4 sm:p-6">
      <style>{`
        @keyframes aitp-pop {
          0% { transform: scale(0.92) translateY(8px); opacity: 0; }
          100% { transform: scale(1) translateY(0); opacity: 1; }
        }
        @keyframes aitp-stripe {
          0% { background-position: 0 0; }
          100% { background-position: 28px 0; }
        }
      `}</style>

      <div
        className="relative w-full max-w-5xl rounded-2xl bg-white shadow-[0_25px_70px_-15px_rgba(0,0,0,0.5)] flex flex-col overflow-hidden ring-1 ring-orange-200"
        style={{ animation: "aitp-pop 0.3s ease forwards", maxHeight: "94vh" }}
      >
        {/* Draft/test hazard stripe — visually distinguishes this from the
            final-preview modal at a glance */}
        <div
          className="h-1.5 shrink-0"
          style={{
            backgroundImage:
              "repeating-linear-gradient(135deg, #f97316 0, #f97316 10px, #fed7aa 10px, #fed7aa 20px)",
            backgroundSize: "28px 100%",
            animation: "aitp-stripe 1.2s linear infinite",
          }}
        />

        {/* Header */}
        <div className="flex items-center justify-between gap-3 px-5 sm:px-6 py-4 border-b border-orange-100 bg-orange-50/60">
          <div className="min-w-0 flex items-start gap-3">
            <span className="inline-flex items-center rounded-full bg-orange-100 text-orange-700 ring-1 ring-orange-300 px-2.5 py-1 text-[11px] font-bold tracking-wide uppercase shrink-0">
              Test Preview
            </span>
            <div className="min-w-0">
              <h3 className="text-base sm:text-lg font-bold text-[var(--smart-navy,#1e3a5f)] leading-tight">
                {copy.title}
              </h3>
              <p className="text-xs text-gray-500 mt-0.5">{copy.description}</p>
            </div>
          </div>

          {/* Close + Download, right side */}
          <div className="flex items-center gap-2 shrink-0">
            <button
              onClick={handleDownload}
              disabled={downloading}
              className="inline-flex items-center gap-1.5 rounded-md bg-orange-500 hover:bg-orange-600 disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-semibold px-4 py-2 shadow-sm transition-colors"
            >
              {downloading ? (
                <svg
                  className="h-4 w-4 animate-spin"
                  viewBox="0 0 24 24"
                  fill="none"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke="currentColor"
                    strokeWidth="3"
                    className="opacity-25"
                  />
                  <path
                    d="M21 12a9 9 0 0 0-9-9"
                    stroke="currentColor"
                    strokeWidth="3"
                    strokeLinecap="round"
                    className="opacity-90"
                  />
                </svg>
              ) : (
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  className="h-4 w-4"
                >
                  <path d="M10 2a1 1 0 0 1 1 1v8.09l2.3-2.3a1 1 0 1 1 1.4 1.42l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.42l2.3 2.3V3a1 1 0 0 1 1-1Z" />
                  <path d="M4 15a1 1 0 0 1 1 1v1h10v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z" />
                </svg>
              )}
              {downloading ? "Downloading..." : "Download"}
            </button>

            <button
              onClick={onClose}
              aria-label="Close test preview"
              className="inline-flex items-center justify-center h-9 w-9 rounded-md bg-white hover:bg-orange-100 ring-1 ring-inset ring-orange-200 text-orange-600 transition-colors"
            >
              <svg viewBox="0 0 20 20" fill="currentColor" className="h-4 w-4">
                <path
                  fillRule="evenodd"
                  d="M10 8.59 6.7 5.29a1 1 0 0 0-1.41 1.42L8.59 10l-3.3 3.29a1 1 0 1 0 1.41 1.42L10 11.41l3.29 3.3a1 1 0 0 0 1.42-1.42L11.41 10l3.3-3.29a1 1 0 0 0-1.42-1.42L10 8.59Z"
                  clipRule="evenodd"
                />
              </svg>
            </button>
          </div>
        </div>

        {/* Preview body — sized to the real print page (380x600, matching
            Snappy's page-width/page-height in PdfGeneratorService) so what
            you see here is the actual page boundary, not a stretched card. */}
        <div className="flex-1 overflow-auto bg-[repeating-conic-gradient(#f3f4f6_0%_25%,#fafafa_0%_50%)] bg-[length:16px_16px] p-6 sm:p-10 flex items-center justify-center">
          {loadingPreview ? (
            <p className="text-sm text-gray-500">Loading preview…</p>
          ) : (
            <div className="relative" style={{ width: 380, height: 600 }}>
              {/* Corner crop/registration marks, like a print trim guide */}
              {[
                { top: -14, left: -14, rotate: 0 },
                { top: -14, right: -14, rotate: 90 },
                { bottom: -14, left: -14, rotate: -90 },
                { bottom: -14, right: -14, rotate: 180 },
              ].map((pos, i) => (
                <svg
                  key={i}
                  viewBox="0 0 20 20"
                  className="absolute h-5 w-5 text-orange-400"
                  style={{
                    top: "top" in pos ? pos.top : undefined,
                    bottom: "bottom" in pos ? pos.bottom : undefined,
                    left: "left" in pos ? pos.left : undefined,
                    right: "right" in pos ? pos.right : undefined,
                    transform: `rotate(${pos.rotate}deg)`,
                  }}
                >
                  <path
                    d="M2 2v9M2 2h9"
                    stroke="currentColor"
                    strokeWidth="2"
                    fill="none"
                    strokeLinecap="square"
                  />
                </svg>
              ))}

              {/* The page itself, at true print dimensions */}
              <div className="h-full w-full bg-white shadow-[0_10px_30px_-8px_rgba(0,0,0,0.35)] ring-2 ring-orange-300 overflow-hidden">
                <iframe
                  title={copy.title}
                  srcDoc={previewHtml ?? ""}
                  scrolling="no"
                  style={{
                    width: 380,
                    height: 600,
                    border: "none",
                    display: "block",
                  }}
                />
              </div>

              {/* Page size label */}
              <div className="absolute left-1/2 -bottom-8 -translate-x-1/2 whitespace-nowrap text-[11px] font-medium text-gray-400">
                Print page — 380 × 600px
              </div>
            </div>
          )}
        </div>

        {error && (
          <div className="px-5 sm:px-6 py-3 border-t border-red-100 bg-red-50">
            <p className="text-sm text-[var(--smart-red,#c0392b)]">{error}</p>
          </div>
        )}
      </div>
    </div>,
    document.body
  );
}
